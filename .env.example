# Base URL of the Express API server (no trailing slash)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api

# Origin of the Express server running BetterAuth (no trailing slash)
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:5000

# Stripe publishable key — safe for the browser. The secret key must NEVER
# be set here; it belongs to the server's environment only.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
