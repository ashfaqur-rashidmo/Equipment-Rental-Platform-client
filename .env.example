# Copy this file to .env and fill in the values.
# NEVER commit the real .env file.

# URLs
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Auth
BETTER_AUTH_SECRET=<random secret>
BETTER_AUTH_DB_URI=<mongodb connection string>
BETTER_AUTH_GOOGLE_CLIENT_ID=<google client id>
BETTER_AUTH_GOOGLE_CLIENT_SECRET=<google client secret>

# Uploads & payments
NEXT_PUBLIC_IMGBB_API_KEY=<imgbb key>
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<stripe publishable key>
STRIPE_SECRET_KEY=<stripe secret key>

# Email verification — ONE sender for the whole website.
# Create a free key at https://resend.com/api-keys (starts with re_...)
RESEND_API_KEY=<resend api key>

# Used as the "from" address. The default works only for your own Resend email.
# After verifying your domain in Resend, change to:
# EMAIL_FROM=EquipRent <no-reply@yourdomain.com>
EMAIL_FROM=EquipRent <onboarding@resend.dev>
